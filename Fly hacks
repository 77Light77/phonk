local function setGuiOpen(open)
    Settings.guiOpen = open
    if not guiFrame then return end
    if open then
        guiFrame.Visible = true
        rebuildPlayerList()
        switchTab(currentTab)
        local baseScale = Settings.uiScale
        ui.uiScale.Scale = baseScale * 0.85
        TweenService:Create(ui.uiScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            {Scale = baseScale}):Play()
    else
        local baseScale = Settings.uiScale
        local t = TweenService:Create(ui.uiScale, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {Scale = baseScale * 0.9})
        t:Play()
        t.Completed:Connect(function()
            guiFrame.Visible = false
            ui.uiScale.Scale = baseScale
        end)
    end
end

-- ============ KEYBIND REBIND ============
local function promptRebind(target, btnObj, infoValue)
    if rebindingAny then return end
    rebindingAny = true
    if btnObj and btnObj.label then
        btnObj.label.Text = "PRESS A KEY..."
        btnObj.label.TextColor3 = Theme.warn
    end
    if infoValue then infoValue.Text = "..." end
    notify("Press a key to bind...", Theme.warn)

    local done = false
    local conn
    local function finish()
        if done then return end
        done = true
        rebindingAny = false
        if btnObj and btnObj.label then
            btnObj.label.Text = "CHANGE KEYBIND"
            if btnObj.btn:GetAttribute("ToggledOn") then
                btnObj.label.TextColor3 = Color3.fromRGB(255,255,255)
            else
                btnObj.label.TextColor3 = Theme.text
            end
        end
        if conn then conn:Disconnect() end
    end

    conn = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local key = input.KeyCode
        if key == Enum.KeyCode.Unknown then return end
        if keyConflicts(key, target) then
            notify("Key already in use", Theme.danger)
            if infoValue then infoValue.Text = "Conflict" end
        else
            local keyName = tostring(key):gsub("Enum.KeyCode.","")
            if target == "ui" then
                Settings.uiKey = key
            elseif target == "fly" then
                Settings.toggleKey = key
                if infoValue then infoValue.Text = keyName end
            elseif target == "fc" then
                Freecam.keybind = key
                if infoValue then infoValue.Text = keyName end
            elseif target == "ws" then
                Settings.walkSpeedKey = key
                if infoValue then infoValue.Text = keyName end
            elseif target == "nc" then
                Settings.noclipKey = key
                if infoValue then infoValue.Text = keyName end
            elseif target == "pt" then
                Settings.potatoKey = key
                if infoValue then infoValue.Text = keyName end
            end
            notify("Bound to "..keyName, Theme.accent)
        end
        finish()
    end)
end

local function promptRebindInput()
    if rebindingAny then return end
    rebindingAny = true
    if ui.clickTeleportInputBtn and ui.clickTeleportInputBtn.label then
        ui.clickTeleportInputBtn.label.Text = "PRESS A BUTTON..."
        ui.clickTeleportInputBtn.label.TextColor3 = Theme.warn
    end
    if ui.clickTeleportValue then ui.clickTeleportValue.Text = "..." end
    notify("Press a mouse button to bind...", Theme.warn)

    local done = false
    local conn
    local function finish()
        if done then return end
        done = true
        rebindingAny = false
        if ui.clickTeleportInputBtn and ui.clickTeleportInputBtn.label then
            ui.clickTeleportInputBtn.label.Text = "REBIND INPUT"
            ui.clickTeleportInputBtn.label.TextColor3 = Theme.text
        end
        if conn then conn:Disconnect() end
    end

    conn = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
           and input.UserInputType ~= Enum.UserInputType.MouseButton2
           and input.UserInputType ~= Enum.UserInputType.MouseButton3 then return end
        Settings.clickTeleportInput = input.UserInputType
        if ui.clickTeleportValue then
            ui.clickTeleportValue.Text = clickTeleportInputToString(input.UserInputType)
        end
        notify("Bound to "..clickTeleportInputToString(input.UserInputType), Theme.accent)
        finish()
    end)
end

