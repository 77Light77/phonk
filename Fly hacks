function switchTab(name)
    local prev = currentTab
    currentTab = name
    if not ui.tabFrames then return end
    for tn, f in pairs(ui.tabFrames) do
        if f then f.Visible = (tn==name) end
    end
    if ui.tabButtons then
        for tn, d in pairs(ui.tabButtons) do
            if d.label then
                if tn == name then
                    d.label.TextColor3 = Theme.text
                else
                    d.label.TextColor3 = Theme.textDim
                end
            end
            if d.underline then
                TweenService:Create(d.underline, TweenInfo.new(0.18),
                    {BackgroundTransparency = (tn==name) and 0 or 1}):Play()
            end
        end
    end
    local newFrame = ui.tabFrames[name]
    if newFrame and prev ~= name then
        local targetPos = UDim2.new(0, 0, 0, 0)
        newFrame.Position = UDim2.new(0, 8, 0, 0)
        newFrame.BackgroundTransparency = 1
        TweenService:Create(newFrame, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            {Position = targetPos}):Play()
    end
    if name=="ESP" then rebuildPlayerList() end
    if name=="SERVER" and ui.serverPlayersValue then
        ui.serverPlayersValue.Text = #Players:GetPlayers().." / "..Players.MaxPlayers
    end
end

