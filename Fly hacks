end)

-- ============ CLICK TELEPORT ============
function doTeleportFromMouse()
    local cam = workspace.CurrentCamera; if not cam then return end
    local mouse = UserInputService:GetMouseLocation()
    local ray = cam:ViewportPointToRay(mouse.X, mouse.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { player.Character }
    local result = workspace:Raycast(ray.Origin, ray.Direction * 5000, params)
    if result and result.Position then
        local c = player.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if r then
            r.CFrame = CFrame.new(result.Position + Vector3.new(0, 3, 0))
            notify("Teleported", Theme.accent)
        end
    end
end

-- ============ INFINITE ZOOM ============
local INFINITE_MAX = 1e9
local INFINITE_MIN = 0.5
function setInfiniteZoom(on)
    Settings.infiniteZoom = on
    if on then
        if not InfiniteZoom.originalMax then
            InfiniteZoom.originalMax = player.CameraMaxZoomDistance
            InfiniteZoom.originalMin = player.CameraMinZoomDistance
        end
        pcall(function()
            player.CameraMaxZoomDistance = INFINITE_MAX
            player.CameraMinZoomDistance = INFINITE_MIN
        end)
        if not InfiniteZoom.conn then
            InfiniteZoom.conn = player:GetPropertyChangedSignal("CameraMaxZoomDistance"):Connect(function()
                if Settings.infiniteZoom and player.CameraMaxZoomDistance < INFINITE_MAX then
                    pcall(function() player.CameraMaxZoomDistance = INFINITE_MAX end)
                end
            end)
        end
    else
        if InfiniteZoom.originalMax then
            pcall(function()
                player.CameraMaxZoomDistance = InfiniteZoom.originalMax
                player.CameraMinZoomDistance = InfiniteZoom.originalMin
            end)
        end
        if InfiniteZoom.conn then InfiniteZoom.conn:Disconnect(); InfiniteZoom.conn = nil end
        InfiniteZoom.originalMax = nil; InfiniteZoom.originalMin = nil
    end
    if updateUI then updateUI() end
    if updateTabIndicators then updateTabIndicators() end
end

-- ============ POTATO ============
local function potatoApplyPartOnly(part)
    if not part or not part.Parent then return end
    if not part:IsA("BasePart") then return end
    pcall(function()
        if part.Material ~= Enum.Material.SmoothPlastic then
            part.Material = Enum.Material.SmoothPlastic
        end
    end)
    if part:IsA("MeshPart") then
        pcall(function()
            if part.TextureID ~= "" then part.TextureID = "" end
        end)
    end
    if part:IsA("Part") or part:IsA("WedgePart") or part:IsA("CornerWedgePart") then
        pcall(function()
            if part.TopSurface ~= Enum.SurfaceType.Smooth then part.TopSurface = Enum.SurfaceType.Smooth end
            if part.BottomSurface ~= Enum.SurfaceType.Smooth then part.BottomSurface = Enum.SurfaceType.Smooth end
            if part.LeftSurface ~= Enum.SurfaceType.Smooth then part.LeftSurface = Enum.SurfaceType.Smooth end
            if part.RightSurface ~= Enum.SurfaceType.Smooth then part.RightSurface = Enum.SurfaceType.Smooth end
            if part.FrontSurface ~= Enum.SurfaceType.Smooth then part.FrontSurface = Enum.SurfaceType.Smooth end
            if part.BackSurface ~= Enum.SurfaceType.Smooth then part.BackSurface = Enum.SurfaceType.Smooth end
        end)
    end
    for _, c in ipairs(part:GetChildren()) do
        if c:IsA("Texture") or c:IsA("Decal") then
            pcall(function() if c.Transparency < 1 then c.Transparency = 1 end end)
        elseif c:IsA("SurfaceAppearance") then
            pcall(function()
                if c.ColorMap ~= "" then c.ColorMap = "" end
                if c.NormalMap ~= "" then c.NormalMap = "" end
                if c.RoughnessMap ~= "" then c.RoughnessMap = "" end
                if c.MetalnessMap ~= "" then c.MetalnessMap = "" end
            end)
        elseif c:IsA("ParticleEmitter") or c:IsA("Fire") or c:IsA("Smoke")
            or c:IsA("Sparkles") or c:IsA("Beam") or c:IsA("Trail")
            or c:IsA("PointLight") or c:IsA("SpotLight") or c:IsA("SurfaceLight") then
            pcall(function() if c.Enabled then c.Enabled = false end end)
        end
    end
end

local function potatoSaveStripPart(part)
    if not part or not part.Parent then return end
    if not part:IsDescendantOf(workspace) then return end
    if not part:IsA("BasePart") then return end

    if not part:GetAttribute(POTATO_TAG) then
        part:SetAttribute(POTATO_TAG, true)
        pcall(function() Potato.savedMaterial[part] = part.Material end)
        if part:IsA("MeshPart") then
            pcall(function() Potato.savedTextureID[part] = part.TextureID end)
        end
        if part:IsA("Part") or part:IsA("WedgePart") or part:IsA("CornerWedgePart") then
            pcall(function()
                Potato.savedSurface[part] = {
                    Top=part.TopSurface, Bottom=part.BottomSurface,
                    Left=part.LeftSurface, Right=part.RightSurface,
                    Front=part.FrontSurface, Back=part.BackSurface,
                }
            end)
        end
    end

    for _, c in ipairs(part:GetChildren()) do
        if Potato.savedChild[c] == nil then
            if c:IsA("Texture") or c:IsA("Decal") then
                Potato.savedChild[c] = { kind="tex", val=c.Transparency }
            elseif c:IsA("SurfaceAppearance") then
                Potato.savedChild[c] = {
                    kind="sa",
                    ColorMap=c.ColorMap, NormalMap=c.NormalMap,
                    RoughnessMap=c.RoughnessMap, MetalnessMap=c.MetalnessMap,
                }
            elseif c:IsA("ParticleEmitter") or c:IsA("Fire") or c:IsA("Smoke")
                or c:IsA("Sparkles") or c:IsA("Beam") or c:IsA("Trail")
                or c:IsA("PointLight") or c:IsA("SpotLight") or c:IsA("SurfaceLight") then
                Potato.savedChild[c] = { kind="emitter", val=c.Enabled }
            end
        end
    end

    potatoApplyPartOnly(part)

    if not part:GetAttribute(POTATO_WATCH) then
        part:SetAttribute(POTATO_WATCH, true)
        pcall(function()
            part:GetPropertyChangedSignal("Material"):Connect(function()
                if not Potato.active then return end
                if part.Material ~= Enum.Material.SmoothPlastic then
                    pcall(function() part.Material = Enum.Material.SmoothPlastic end)
                end
            end)
        end)
        if part:IsA("MeshPart") then
            pcall(function()
                part:GetPropertyChangedSignal("TextureID"):Connect(function()
                    if not Potato.active then return end
                    if part.TextureID ~= "" then
                        pcall(function() part.TextureID = "" end)
                    end
                end)
            end)
        end
        pcall(function()
            part.ChildAdded:Connect(function(c)
                if not Potato.active then return end
                task.defer(function()
                    if not Potato.active or not c or not c.Parent then return end
                    if Potato.savedChild[c] == nil then
                        if c:IsA("Texture") or c:IsA("Decal") then
                            Potato.savedChild[c] = { kind="tex", val=c.Transparency }
                        elseif c:IsA("SurfaceAppearance") then
                            Potato.savedChild[c] = {
                                kind="sa",
                                ColorMap=c.ColorMap, NormalMap=c.NormalMap,
                                RoughnessMap=c.RoughnessMap, MetalnessMap=c.MetalnessMap,
                            }
                        elseif c:IsA("ParticleEmitter") or c:IsA("Fire") or c:IsA("Smoke")
                            or c:IsA("Sparkles") or c:IsA("Beam") or c:IsA("Trail")
                            or c:IsA("PointLight") or c:IsA("SpotLight") or c:IsA("SurfaceLight") then
                            Potato.savedChild[c] = { kind="emitter", val=c.Enabled }
                        end
                    end
                    if c:IsA("Texture") or c:IsA("Decal") then
                        pcall(function() if c.Transparency < 1 then c.Transparency = 1 end end)
                    elseif c:IsA("SurfaceAppearance") then
                        pcall(function()
                            c.ColorMap = ""; c.NormalMap = ""
                            c.RoughnessMap = ""; c.MetalnessMap = ""
                        end)
                    elseif c:IsA("ParticleEmitter") or c:IsA("Fire") or c:IsA("Smoke")
                        or c:IsA("Sparkles") or c:IsA("Beam") or c:IsA("Trail")
                        or c:IsA("PointLight") or c:IsA("SpotLight") or c:IsA("SurfaceLight") then
                        pcall(function() if c.Enabled then c.Enabled = false end end)
                    end
                end)
            end)
        end)
    end
end

local function potatoSaveStripChild(c)
    if not c or not c.Parent then return end
    if Potato.savedChild[c] == nil then
        if c:IsA("Texture") or c:IsA("Decal") then
            Potato.savedChild[c] = { kind="tex", val=c.Transparency }
        elseif c:IsA("SurfaceAppearance") then
            Potato.savedChild[c] = {
                kind="sa",
                ColorMap=c.ColorMap, NormalMap=c.NormalMap,
                RoughnessMap=c.RoughnessMap, MetalnessMap=c.MetalnessMap,
            }
        elseif c:IsA("ParticleEmitter") or c:IsA("Fire") or c:IsA("Smoke")
            or c:IsA("Sparkles") or c:IsA("Beam") or c:IsA("Trail")
            or c:IsA("PointLight") or c:IsA("SpotLight") or c:IsA("SurfaceLight") then
            Potato.savedChild[c] = { kind="emitter", val=c.Enabled }
        end
    end
    if c:IsA("Texture") or c:IsA("Decal") then
        pcall(function() if c.Transparency < 1 then c.Transparency = 1 end end)
    elseif c:IsA("SurfaceAppearance") then
        pcall(function()
            c.ColorMap = ""; c.NormalMap = ""
            c.RoughnessMap = ""; c.MetalnessMap = ""
        end)
    elseif c:IsA("ParticleEmitter") or c:IsA("Fire") or c:IsA("Smoke")
        or c:IsA("Sparkles") or c:IsA("Beam") or c:IsA("Trail")
        or c:IsA("PointLight") or c:IsA("SpotLight") or c:IsA("SurfaceLight") then
        pcall(function() if c.Enabled then c.Enabled = false end end)
    end
end

local function potatoSweep()
    local i = 0
    for _, d in ipairs(workspace:GetDescendants()) do
        if not Potato.active then return end
        if d:IsA("BasePart") then
            if d:GetAttribute(POTATO_TAG) then
                potatoApplyPartOnly(d)
            else
                potatoSaveStripPart(d)
            end
        elseif d:IsA("Texture") or d:IsA("Decal") or d:IsA("SurfaceAppearance")
            or d:IsA("ParticleEmitter") or d:IsA("Fire") or d:IsA("Smoke")
            or d:IsA("Sparkles") or d:IsA("Beam") or d:IsA("Trail")
            or d:IsA("PointLight") or d:IsA("SpotLight") or d:IsA("SurfaceLight") then
            potatoSaveStripChild(d)
        end
        i = i + 1
        if i >= 3000 then i = 0; task.wait() end
    end
end

local function potatoStartSweep()
    if Potato.sweepAlive then return end
    Potato.sweepAlive = true
    task.spawn(function()
        potatoSweep()
        while Potato.active do
            task.wait(0.4)
            if Potato.active then potatoSweep() end
        end
        Potato.sweepAlive = false
    end)
end

local function potatoRestoreAll()
    for part, mat in pairs(Potato.savedMaterial) do
        if part and part.Parent then
            pcall(function() part.Material = mat end)
            pcall(function() part:SetAttribute(POTATO_TAG, nil) end)
        end
    end
    Potato.savedMaterial = {}
    for part, tex in pairs(Potato.savedTextureID) do
        if part and part.Parent then pcall(function() part.TextureID = tex end) end
    end
    Potato.savedTextureID = {}
    for part, s in pairs(Potato.savedSurface) do
        if part and part.Parent then
            pcall(function()
                part.TopSurface = s.Top; part.BottomSurface = s.Bottom
                part.LeftSurface = s.Left; part.RightSurface = s.Right
                part.FrontSurface = s.Front; part.BackSurface = s.Back
            end)
        end
    end
    Potato.savedSurface = {}
    for inst, rec in pairs(Potato.savedChild) do
        if inst and inst.Parent then
            if rec.kind == "tex" then
                pcall(function() inst.Transparency = rec.val end)
            elseif rec.kind == "sa" then
                pcall(function()
                    inst.ColorMap = rec.ColorMap; inst.NormalMap = rec.NormalMap
                    inst.RoughnessMap = rec.RoughnessMap; inst.MetalnessMap = rec.MetalnessMap
                end)
            elseif rec.kind == "emitter" then
                pcall(function() inst.Enabled = rec.val end)
            end
        end
    end
    Potato.savedChild = {}
end

function setPotato(on)
    Potato.active = on
    Settings.potato = on
    if updateUI then task.defer(updateUI) end
    if updateTabIndicators then task.defer(updateTabIndicators) end

    if on then
        if not Potato.savedLighting then
            Potato.savedLighting = {
                GlobalShadows=Lighting.GlobalShadows,
                Brightness=Lighting.Brightness,
                Ambient=Lighting.Ambient,
                OutdoorAmbient=Lighting.OutdoorAmbient,
                EnvironmentDiffuseScale=Lighting.EnvironmentDiffuseScale,
                EnvironmentSpecularScale=Lighting.EnvironmentSpecularScale,
                FogEnd=Lighting.FogEnd,
            }
        end
        pcall(function()
            Lighting.GlobalShadows = false
            Lighting.Brightness = 1
            Lighting.Ambient = Color3.fromRGB(180,180,180)
            Lighting.OutdoorAmbient = Color3.fromRGB(180,180,180)
            Lighting.EnvironmentDiffuseScale = 0
            Lighting.EnvironmentSpecularScale = 0
            Lighting.FogEnd = 1e6
        end)
        for _, c in ipairs(Lighting:GetChildren()) do
            if c:IsA("PostEffect") or c:IsA("Atmosphere") then
                if Potato.savedPostFx[c] == nil then Potato.savedPostFx[c] = c.Enabled end
                pcall(function() c.Enabled = false end)
            end
        end
        if not Potato.descendantConn then
            Potato.descendantConn = workspace.DescendantAdded:Connect(function(d)
                if not Potato.active or not d or not d.Parent then return end
                task.defer(function()
                    if not Potato.active or not d or not d.Parent then return end
                    if d:IsA("BasePart") then
                        potatoSaveStripPart(d)
                    else
                        potatoSaveStripChild(d)
                    end
                end)
            end)
        end
        potatoStartSweep()
    else
        if Potato.savedLighting then
            for k, v in pairs(Potato.savedLighting) do
                pcall(function() Lighting[k] = v end)
            end
            Potato.savedLighting = nil
        end
        for fx, state in pairs(Potato.savedPostFx) do
            if fx and fx.Parent then pcall(function() fx.Enabled = state end) end
        end
        Potato.savedPostFx = {}
        potatoRestoreAll()
        if Potato.descendantConn then
            Potato.descendantConn:Disconnect()
            Potato.descendantConn = nil
        end
    end

    if updateUI then updateUI() end
    if updateTabIndicators then updateTabIndicators() end
end

-- ============ FULLBRIGHT ============
function applyFullbright(on)
    Settings.fullbright = on
    if on then
        if not Fullbright.original then
            Fullbright.original = {
                Ambient=Lighting.Ambient, OutdoorAmbient=Lighting.OutdoorAmbient,
                Brightness=Lighting.Brightness, GlobalShadows=Lighting.GlobalShadows,
                FogEnd=Lighting.FogEnd,
            }
        end
        Lighting.Ambient = Color3.fromRGB(200,200,200)
        Lighting.OutdoorAmbient = Color3.fromRGB(200,200,200)
        Lighting.Brightness = 3; Lighting.GlobalShadows = false; Lighting.FogEnd = 1e6
    else
        if Fullbright.original then
            Lighting.Ambient = Fullbright.original.Ambient
            Lighting.OutdoorAmbient = Fullbright.original.OutdoorAmbient
            Lighting.Brightness = Fullbright.original.Brightness
            Lighting.GlobalShadows = Fullbright.original.GlobalShadows
            Lighting.FogEnd = Fullbright.original.FogEnd
            Fullbright.original = nil
        end
    end
end

