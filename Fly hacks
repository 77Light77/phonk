-- ============ REFRESH UI AFTER LOAD / RESET ============
function refreshUIAfterLoad()
    -- Sliders
    if ui.flySlider then ui.flySlider.setValueSilent(Settings.flySpeed) end
    if ui.fcSlider then ui.fcSlider.setValueSilent(Freecam.speed) end
    if ui.walkSpeedSlider then ui.walkSpeedSlider.setValueSilent(Settings.walkSpeed) end
    if ui.jumpPowerSlider then ui.jumpPowerSlider.setValueSilent(Settings.jumpPower) end
    if ui.espScaleSlider then ui.espScaleSlider.setValueSilent(math.floor(Settings.espScale*100)) end
    if ui.scaleSlider then ui.scaleSlider.setValueSilent(math.floor(Settings.uiScale*100)) end
    if ui.spectateZoomSlider then ui.spectateZoomSlider.setValueSilent(Settings.spectateZoom) end

    -- Keybind labels
    if ui.flyKeyValue then ui.flyKeyValue.Text = tostring(Settings.toggleKey):gsub("Enum.KeyCode.","") end
    if ui.freecamKeyValue then ui.freecamKeyValue.Text = tostring(Freecam.keybind):gsub("Enum.KeyCode.","") end
    if ui.walkSpeedKeyValue then ui.walkSpeedKeyValue.Text = tostring(Settings.walkSpeedKey):gsub("Enum.KeyCode.","") end
    if ui.noclipKeyValue then ui.noclipKeyValue.Text = tostring(Settings.noclipKey):gsub("Enum.KeyCode.","") end
    if ui.potatoKeyValue then ui.potatoKeyValue.Text = tostring(Settings.potatoKey):gsub("Enum.KeyCode.","") end
    if ui.clickTeleportValue then ui.clickTeleportValue.Text = clickTeleportInputToString(Settings.clickTeleportInput) end

    -- UI scale
    if ui.uiScale then ui.uiScale.Scale = Settings.uiScale end

    -- Clock
    if ui.clockFrame then ui.clockFrame.Visible = Settings.clockEnabled end

    -- Theme
    applyTheme(Settings.themeName)

    -- ESP color
    setESPColor(ESP.colorName)

    -- Restore ESP selections for existing players
    applyPendingESPSelections()

    -- Rebuild ESP entries if running
    if ESP.enabled then
        for plr, _ in pairs(ESP.entries) do removeESPForPlayer(plr) end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and ESP.selected[plr] then createESPForPlayer(plr) end
        end
    end

    -- Runtime states
    if Settings.walkSpeedEnabled then applyWalkSpeed() end
    if Settings.jumpPowerEnabled then applyJumpPower() end
    if Settings.noclip then
        local c = player.Character
        if c then noclipApplyToCharacter(c); noclipHookCharacter(c) end
    end
    if Settings.fullbright and not Fullbright.original then applyFullbright(true) end
    if not Settings.fullbright and Fullbright.original then applyFullbright(false) end
    if Settings.infiniteZoom and not InfiniteZoom.originalMax then setInfiniteZoom(true) end
    if not Settings.infiniteZoom and InfiniteZoom.originalMax then setInfiniteZoom(false) end
    if Settings.potato and not Potato.active then setPotato(true) end
    if not Settings.potato and Potato.active then setPotato(false) end

    rebuildPlayerList()
    updateUI()
    updateTabIndicators()
end

-- ============ RESET TO DEFAULTS ============
function resetToDefaults()
    -- 1) Shut down all runtime features safely first
    if Settings.flying then pcall(stopFly) end
    if Freecam.active then pcall(stopFreecam) end
    if Spectate.active then pcall(stopSpectate) end
    if ESP.enabled then pcall(disableESP) end
    if Settings.noclip then pcall(setNoclip, false) end
    if Settings.potato then pcall(setPotato, false) end
    if Settings.infiniteZoom then pcall(setInfiniteZoom, false) end
    if Settings.fullbright then pcall(applyFullbright, false) end
    if Settings.walkSpeedEnabled then pcall(setWalkSpeedEnabled, false) end
    if Settings.jumpPowerEnabled then pcall(setJumpPowerEnabled, false) end

    -- 2) Restore every setting to factory default
    Settings.flySpeed = DEFAULTS.flySpeed
    Settings.toggleKey = DEFAULTS.toggleKey
    Settings.uiKey = DEFAULTS.uiKey
    Settings.uiScale = DEFAULTS.uiScale
    Settings.notifications = DEFAULTS.notifications
    Settings.spectateZoom = DEFAULTS.spectateZoom
    Settings.tracers = DEFAULTS.tracers
    Settings.clockEnabled = DEFAULTS.clockEnabled
    Settings.walkSpeed = DEFAULTS.walkSpeed
    Settings.walkSpeedEnabled = DEFAULTS.walkSpeedEnabled
    Settings.walkSpeedKey = DEFAULTS.walkSpeedKey
    Settings.jumpPower = DEFAULTS.jumpPower
    Settings.jumpPowerEnabled = DEFAULTS.jumpPowerEnabled
    Settings.infiniteJump = DEFAULTS.infiniteJump
    Settings.noclip = DEFAULTS.noclip
    Settings.noclipKey = DEFAULTS.noclipKey
    Settings.potato = DEFAULTS.potato
    Settings.potatoKey = DEFAULTS.potatoKey
    Settings.infiniteZoom = DEFAULTS.infiniteZoom
    Settings.espScale = DEFAULTS.espScale
    Settings.espNames = DEFAULTS.espNames
    Settings.clickTeleport = DEFAULTS.clickTeleport
    Settings.clickTeleportInput = DEFAULTS.clickTeleportInput
    Settings.themeName = DEFAULTS.themeName
    Settings.fullbright = DEFAULTS.fullbright
    Settings.pendingESPUserIds = {}
    Freecam.speed = DEFAULTS.freecamSpeed
    Freecam.keybind = DEFAULTS.freecamKeybind
    ESP.colorName = DEFAULTS.espColorName
    local p = COLOR_PRESETS[DEFAULTS.espColorName]
    if p then ESPColor.fill = p.fill; ESPColor.outline = p.outline; ESPColor.dist = p.dist end
    ESP.selected = {}

    -- 3) Refresh UI + runtime
    refreshUIAfterLoad()

    -- 4) Delete save file (if possible) so next launch is default too
    if hasFileIO() then
        if type(delfile) == "function" then
            pcall(function()
                if isfile(SAVE_FILE) then delfile(SAVE_FILE) end
            end)
            Save.status = "Defaults restored (save cleared)"
        else
            -- Can't delete; overwrite with defaults instead
            doSave()
            Save.status = "Defaults restored (save overwritten)"
        end
    else
        Save.status = "Defaults restored (in memory only)"
    end

    if ui.saveStatus then ui.saveStatus.Text = Save.status end
    notify("Settings reset to defaults", Theme.warn)
end

