RunService.RenderStepped:Connect(function(dt)
    if not Spectate.active or not Spectate.target then return end
    if Freecam.active then return end
    local tp = Spectate.target
    if not tp.Parent then stopSpectate(); return end
    local tc = tp.Character; if not tc then return end
    local tr = tc:FindFirstChild("HumanoidRootPart"); if not tr then return end
    local cam = workspace.CurrentCamera; if not cam then return end
    if cam.CameraType ~= Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Scriptable end
    local rp = tr.Position; local rcf = tr.CFrame
    local look = rcf.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 0.001 then flat = Vector3.new(0,0,-1) else flat = flat.Unit end
    local dp = rp - flat*Settings.spectateZoom + Vector3.new(0,6,0)
    local dl = rp + Vector3.new(0,2.2,0)
    if not Spectate.smoothPos then Spectate.smoothPos=dp; Spectate.smoothLook=dl end
    local a = 1 - math.exp(-12*dt)
    Spectate.smoothPos = Spectate.smoothPos:Lerp(dp, a)
    Spectate.smoothLook = Spectate.smoothLook:Lerp(dl, a)
    cam.CFrame = CFrame.lookAt(Spectate.smoothPos, Spectate.smoothLook)
end)
RunService.Heartbeat:Connect(function()
    if not Freecam.active then return end
    local c = player.Character; if not c then return end
    local r = c:FindFirstChild("HumanoidRootPart")
    if r and not r.Anchored then r.Anchored = true end
    local h = c:FindFirstChildOfClass("Humanoid")
    if h then
        if h.WalkSpeed~=0 then h.WalkSpeed=0 end
        if h.JumpPower~=0 then h.JumpPower=0 end
    end
end)
RunService.RenderStepped:Connect(function(dt)
    if not Freecam.active then return end
    if isTyping() then return end
    local cam = workspace.CurrentCamera; if not cam then return end
    if cam.CameraType ~= Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Scriptable end
    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local d = UserInputService:GetMouseDelta()
        Freecam.yaw = Freecam.yaw - d.X*0.005
        Freecam.pitch = math.clamp(Freecam.pitch - d.Y*0.005, -math.rad(89), math.rad(89))
    end
    local rot = CFrame.fromEulerAnglesYXZ(Freecam.pitch, Freecam.yaw, 0)
    local mv = Vector3.new(0,0,0)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv = mv + rot.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv = mv - rot.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv = mv + rot.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv = mv - rot.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv = mv + Vector3.new(0,1,0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
        mv = mv - Vector3.new(0,1,0)
    end
    local np = Freecam.cframe.Position
    if mv.Magnitude > 0.001 then np = np + mv.Unit * Freecam.speed * dt end
    Freecam.cframe = CFrame.new(np) * rot
    cam.CFrame = Freecam.cframe
end)
UserInputService.InputBegan:Connect(function(input)
    if not Freecam.active then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        if Freecam.active then UserInputService.MouseBehavior = Enum.MouseBehavior.Default end
    end
end)

