function createESPForPlayer(plr)
    if plr==player then return end
    if ESP.entries[plr] then return end
    if not ESP.selected[plr] then return end
    local e = { conns={} }; ESP.entries[plr] = e; buildEntryVisuals(plr, e)
    e.conns[#e.conns+1] = plr.CharacterAdded:Connect(function()
        clearEntryVisuals(e)
        local char = plr.Character or plr.CharacterAdded:Wait()
        char:WaitForChild("HumanoidRootPart",10); task.wait(0.05)
        if ESP.enabled and ESP.selected[plr] and ESP.entries[plr] then buildEntryVisuals(plr,e) end
    end)
end
function removeESPForPlayer(plr)
    local e = ESP.entries[plr]; if not e then return end
    clearEntryVisuals(e)
    for _,c in ipairs(e.conns) do if c.Connected then c:Disconnect() end end
    ESP.entries[plr] = nil
end
local function enableESP()
    ESP.enabled = true
    for _,plr in ipairs(Players:GetPlayers()) do if ESP.selected[plr] then createESPForPlayer(plr) end end
    if not ESP.addedConn then
        ESP.addedConn = Players.PlayerAdded:Connect(function(plr)
            task.wait(0.2); rebuildPlayerList()
            if ESP.enabled and ESP.selected[plr] then createESPForPlayer(plr) end
        end)
    end
    if not ESP.removedConn then
        ESP.removedConn = Players.PlayerRemoving:Connect(function(plr)
            ESP.selected[plr] = nil; removeESPForPlayer(plr)
            if Spectate.target==plr then stopSpectate() end
            rebuildPlayerList()
        end)
    end
    notify("ESP enabled", Theme.accent); updateUI(); updateTabIndicators()
end
function disableESP()
    ESP.enabled = false
    for plr,_ in pairs(ESP.entries) do removeESPForPlayer(plr) end
    ESP.entries = {}; notify("ESP disabled", Theme.danger); updateUI(); updateTabIndicators()
end
function toggleESP() if ESP.enabled then disableESP() else enableESP() end end
local function setESPColor(name)
    local p = COLOR_PRESETS[name]; if not p then return end
    ESP.colorName = name; ESPColor.fill=p.fill; ESPColor.outline=p.outline; ESPColor.dist=p.dist
    for _, e in pairs(ESP.entries) do
        if e.highlight then e.highlight.FillColor=p.fill; e.highlight.OutlineColor=p.outline end
        if e.distLabel then e.distLabel.TextColor3=p.dist end
        if e.tracer then e.tracer.BackgroundColor3=p.outline end
    end
    if ui.swatches then
        for n,sw in pairs(ui.swatches) do
            if n==name then sw.stroke.Color=Theme.accent; sw.stroke.Thickness=3
            else sw.stroke.Color=Color3.fromRGB(0,0,0); sw.stroke.Thickness=1 end
        end
    end
end
local function updateESP()
    for plr, e in pairs(ESP.entries) do
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and e.distLabel then
            local d = (plr.Character.HumanoidRootPart.Position - rootPart.Position).Magnitude
            e.distLabel.Text = math.floor(d).." studs"
        end
        if e.healthFill and e.humanoid then
            e.healthFill.Size = UDim2.new(math.clamp(e.humanoid.Health/e.humanoid.MaxHealth,0,1),0,1,0)
        end
        if e.tracer then
            if Settings.tracers and plr.Character and plr.Character:FindFirstChild("Head") then
                local sp = workspace.CurrentCamera:WorldToViewportPoint(plr.Character.Head.Position)
                if sp.Z > 0 then
                    local origin = Vector2.new(workspace.CurrentCamera.ViewportSize.X/2, workspace.CurrentCamera.ViewportSize.Y)
                    local dir = (Vector2.new(sp.X, sp.Y) - origin)
                    local len = dir.Magnitude
                    local ang = math.atan2(dir.Y, dir.X) + math.pi/2
                    e.tracer.Size = UDim2.new(0, 1, 0, len)
                    e.tracer.Position = UDim2.new(0, origin.X, 0, origin.Y)
                    e.tracer.Rotation = math.deg(ang)
                    e.tracer.Visible = true
                else
                    e.tracer.Visible = false
                end
            else
                e.tracer.Visible = false
            end
        end
    end
end
