-- ============ HELPERS ============
local function isTyping() return UserInputService:GetFocusedTextBox() ~= nil end
local function formatUptime(s)
    s = math.max(0, math.floor(s))
    local h, m, sec = math.floor(s/3600), math.floor((s%3600)/60), s%60
    if h>0 then return string.format("%dh %02dm %02ds",h,m,sec)
    elseif m>0 then return string.format("%dm %02ds",m,sec)
    else return string.format("%ds",sec) end
end
local function format12h()
    local t = os.date("*t"); local h = t.hour
    local ap = (h>=12) and "PM" or "AM"; h = h % 12; if h==0 then h=12 end
    return string.format("%d:%02d:%02d %s", h, t.min, t.sec, ap)
end
local function estimateRegion(p)
    if p<=0 then return "—" end
    if p<50 then return "Local" elseif p<100 then return "Nearby"
    elseif p<180 then return "Regional" elseif p<300 then return "Distant"
    else return "Very Far" end
end
local function getPingMs()
    local ok, v = pcall(function() return StatsService.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    if ok and type(v)=="number" and v>0 then return v end
    local f = player:GetNetworkPing()*1000
    if f and f>0 then return f end
    return 0
end
local function clickTeleportInputToString(inp)
    if not inp then return "?" end
    local s = tostring(inp)
    s = s:gsub("Enum%.UserInputType%.", "")
    s = s:gsub("Enum%.KeyCode%.", "")
    if s == "MouseButton1" then return "Left Click" end
    if s == "MouseButton2" then return "Right Click" end
    if s == "MouseButton3" then return "Middle Click" end
    return s
end
local function isClickTeleportInput(input)
    local stored = Settings.clickTeleportInput
    if not stored then return false end
    if typeof(stored) == "EnumItem" then
        if stored.EnumType == Enum.KeyCode then return input.KeyCode == stored
        elseif stored.EnumType == Enum.UserInputType then return input.UserInputType == stored end
    end
    return false
end

-- ============ ENUM SERIALIZATION ============
local function enumToTable(e)
    if typeof(e) ~= "EnumItem" then return e end
    return { __enum = tostring(e.EnumType), Name = e.Name }
end
local function tableToEnum(t)
    if typeof(t) == "EnumItem" then return t end
    if type(t) ~= "table" or not t.__enum or not t.Name then return nil end
    local ok, res = pcall(function() return Enum[t.__enum][t.Name] end)
    if ok and res then return res end
    return nil
end
local function hasFileIO()
    return type(writefile) == "function" and type(readfile) == "function"
       and type(isfile) == "function"
end

