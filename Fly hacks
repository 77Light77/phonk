end
local function freezeCharacter()
    local c = player.Character; if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid"); local r = c:FindFirstChild("HumanoidRootPart")
    if h then
        Freecam.savedWalkSpeed = h.WalkSpeed; Freecam.savedJumpPower = h.JumpPower
        h.WalkSpeed=0; h.JumpPower=0; h.JumpHeight=0
    end
    if r then r.Anchored = true end
    local ct = getPlayerControls(); if ct then pcall(function() ct:Disable() end) end
end
local function unfreezeCharacter()
    local c = player.Character; if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid"); local r = c:FindFirstChild("HumanoidRootPart")
    if h then
        h.WalkSpeed = Freecam.savedWalkSpeed or 16
        h.JumpPower = Freecam.savedJumpPower or 50
        h.JumpHeight = 7.2
