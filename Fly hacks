function updateTabIndicators()
    if not ui.tabButtons then return end
    local visualsActive = Settings.fullbright or Settings.potato
    local movementActive = Settings.infiniteJump or Settings.walkSpeedEnabled or Settings.jumpPowerEnabled or Settings.noclip
    local viewActive = Freecam.active or Settings.infiniteZoom
    local toolsActive = Settings.clickTeleport
    local states = {
        FLY=Settings.flying, MOVEMENT=movementActive, ESP=ESP.enabled,
        VISUALS=visualsActive, VIEW=viewActive, TOOLS=toolsActive,
        SERVER=false, SETTINGS=false,
    }
    for name, active in pairs(states) do
        local d = ui.tabButtons[name]
        if d and d.dot then
            if active then
                d.dot.BackgroundColor3 = Theme.accent
                TweenService:Create(d.dot, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()
            else
                TweenService:Create(d.dot, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
