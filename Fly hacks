function rebuildPlayerList()
    if not ui.playerListScroll then return end
    for _, ch in ipairs(ui.playerListScroll:GetChildren()) do
        if ch:IsA("TextButton") or ch:IsA("Frame") then ch:Destroy() end
    end
    local q = string.lower(Settings.searchText or "")
    local count = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local match
            if q=="" then match=true
            else
                match = string.find(string.lower(plr.Name), q, 1, true) ~= nil
                     or string.find(string.lower(plr.DisplayName), q, 1, true) ~= nil
            end
            if match then createPlayerRow(plr); count = count + 1 end
        end
    end
    if ui.playerCount then
        local total = #Players:GetPlayers()-1
        if q=="" then ui.playerCount.Text = "PLAYERS ("..count..")"
        else ui.playerCount.Text = "PLAYERS ("..count.." / "..total..")" end
    end
    if ui.serverPlayersValue then
        ui.serverPlayersValue.Text = #Players:GetPlayers().." / "..Players.MaxPlayers
    end
    refreshSpectateUI()
end

function refreshSpectateUI()
    if ui.playerListScroll then
