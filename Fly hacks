    if Settings.flying then stopFly() end
    if Spectate.active then stopSpectate() end
    Freecam.active = true; Freecam.cframe = cam.CFrame
    local look = cam.CFrame.LookVector
    Freecam.yaw = math.atan2(-look.X, -look.Z)
    Freecam.pitch = math.asin(math.clamp(look.Y, -1, 1))
    freezeCharacter(); cam.CameraType = Enum.CameraType.Scriptable
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    notify("Freecam enabled", Theme.accent); updateUI(); updateTabIndicators()
end
function stopFreecam()
    if not Freecam.active then return end
    Freecam.active = false
    local cam = workspace.CurrentCamera; if cam then cam.CameraType = Enum.CameraType.Custom end
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    unfreezeCharacter()
    task.defer(function() applyWalkSpeed(); applyJumpPower() end)
    notify("Freecam disabled", Theme.danger); updateUI(); updateTabIndicators()
end

-- ============ SERVER HOP ============
local function serverHop()
    notify("Finding a new server...", Theme.accent)
    local ok, result = pcall(function()
        local url = "https://games.roblox.com/v1/games/"..tostring(game.PlaceId).."/servers/Public?sortOrder=Asc&limit=100"
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if not ok or not result or not result.data then notify("Server hop failed",Theme.danger); return end
    local cand = {}
    for _,s in ipairs(result.data) do
        if type(s)=="table" and s.id and s.id~=game.JobId and (s.playing or 0)<(s.maxPlayers or 0) then
            table.insert(cand, s)
        end
    end
    if #cand==0 then notify("No other servers available", Theme.warn); return end
    local chosen = cand[math.random(1,#cand)]
    notify("Hopping...", Theme.accent); task.wait(0.4)
    TeleportService:TeleportToPlaceInstance(game.PlaceId, chosen.id, player)
end

