local notifContainer
local function ensureNotifContainer()
    if notifContainer and notifContainer.Parent then return notifContainer end
    local sg = player.PlayerGui:FindFirstChild("FlyHacksUI"); if not sg then return nil end
    local c = sg:FindFirstChild("NotifContainer")
    if not c then
        c = Instance.new("Frame"); c.Name="NotifContainer"; c.Size=UDim2.new(0,320,0,400)
        c.Position=UDim2.new(0.5,-160,0,22); c.BackgroundTransparency=1; c.Active=false
        c.Parent=sg
        local l = Instance.new("UIListLayout"); l.Padding=UDim.new(0,6)
        l.SortOrder=Enum.SortOrder.LayoutOrder; l.Parent=c
    end
    notifContainer = c; return c
end
function notify(text, color)
    if not Settings.notifications then return end
    local container = ensureNotifContainer(); if not container then return end
    local accent = color or Theme.accent
    local n = Instance.new("Frame")
    n.Size=UDim2.new(1,0,0,0); n.BackgroundColor3=Theme.surface2; n.BackgroundTransparency=1
    n.BorderSizePixel=0; n.ClipsDescendants=true; n.Active=false; n.Parent=container
    tagBg(n,"surface2")
    local c = Instance.new("UICorner"); c.CornerRadius=UDim.new(0,10); c.Parent=n
    local s = Instance.new("UIStroke"); s.Thickness=1; s.Color=accent; s.Transparency=1; s.Parent=n
    local l = Instance.new("TextLabel"); l.Size=UDim2.new(1,-40,1,0); l.Position=UDim2.new(0,20,0,0)
    l.BackgroundTransparency=1; l.Text=text; l.TextColor3=Theme.text; l.TextSize=13
    l.Font=Enum.Font.GothamMedium; l.TextXAlignment=Enum.TextXAlignment.Left
    l.TextTransparency=1; l.Parent=n
    tagText(l,"text")
    local inInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    TweenService:Create(n,inInfo,{Size=UDim2.new(1,0,0,42),BackgroundTransparency=0}):Play()
    TweenService:Create(s,inInfo,{Transparency=0.55}):Play()
    TweenService:Create(l,inInfo,{TextTransparency=0}):Play()
    task.delay(2.4, function()
        if not n.Parent then return end
        local outInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        TweenService:Create(n,outInfo,{Size=UDim2.new(1,0,0,0),BackgroundTransparency=1}):Play()
        TweenService:Create(s,outInfo,{Transparency=1}):Play()
        TweenService:Create(l,outInfo,{TextTransparency=1}):Play()
        task.wait(0.32); if n.Parent then n:Destroy() end
    end)
end

-- ============ UI FACTORIES ============
local function colorToThemeKey(c)
    if not c then return nil end
    for k, v in pairs(Theme) do
        if typeof(v) == "Color3" and v == c then return k end
    end
    return nil
end

local function makeLabel(parent, o)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency=1; l.Text=o.text or ""; l.TextSize=o.size or 13
    local textColor = o.color or Theme[o.colorKey or "text"]
    local textKey = o.colorKey
    if not textKey and o.color then
        textKey = colorToThemeKey(o.color)
    end
    l.TextColor3 = textColor
    l.Font = o.font or Enum.Font.GothamMedium
    l.Size = o.sizeUDim or UDim2.new(1,0,0,20); l.Position = o.pos or UDim2.new(0,0,0,0)
    l.TextXAlignment = o.align or Enum.TextXAlignment.Left
    l.TextTruncate = Enum.TextTruncate.AtEnd; l.Parent = parent
    if textKey then tagText(l, textKey) end
    return l
end

function pulseButton(btn)
    if not btn then return end
    local b = btn.btn or btn
    local ps = b:FindFirstChild("_PulseScale")
    if not ps then
        ps = Instance.new("UIScale")
        ps.Name = "_PulseScale"
        ps.Scale = 1
        ps.Parent = b
    end
    ps.Scale = 1.06
    TweenService:Create(ps, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
end

local function makeButton(parent, o)
    local b = Instance.new("TextButton")
    b.Size = o.size or UDim2.new(0,200,0,40); b.Position = o.pos or UDim2.new(0,0,0,0)
    b.BackgroundColor3 = o.bg or Theme.surface2; b.BorderSizePixel=0; b.Text=""
    b.AutoButtonColor=false; b.ClipsDescendants=true; b.Parent=parent
    tagBg(b, o.bgKey or "surface2")
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, o.radius or 8); c.Parent=b
    local s = Instance.new("UIStroke"); s.Thickness=1; s.Color = o.border or Theme.border; s.Parent=b
    tagStroke(s, o.borderKey or "border")
    local l = Instance.new("TextLabel")
    l.Size=UDim2.new(1,0,1,0); l.BackgroundTransparency=1; l.Text=o.text or ""
    local textColor = o.textColor or Theme.text
    local textKey = o.textColorKey
    if not textKey and o.textColor then
        textKey = colorToThemeKey(o.textColor)
    end
    l.TextColor3 = textColor; l.TextSize = o.textSize or 14
    l.Font = o.font or Enum.Font.GothamMedium; l.Active=false; l.ZIndex=2; l.Parent=b
    if textKey then tagText(l, textKey) end

    local ps = Instance.new("UIScale")
    ps.Name = "_PulseScale"
    ps.Scale = 1
    ps.Parent = b

    b.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            TweenService:Create(ps, TweenInfo.new(0.08), {Scale = 0.96}):Play()

            -- Ripple animation
            local abs = b.AbsolutePosition
            local loc = UserInputService:GetMouseLocation()
            local relX = loc.X - abs.X
            local relY = loc.Y - abs.Y
            if relX < 0 or relY < 0 or relX > b.AbsoluteSize.X or relY > b.AbsoluteSize.Y then
                relX = b.AbsoluteSize.X * 0.5
                relY = b.AbsoluteSize.Y * 0.5
            end
            local ripple = Instance.new("Frame")
            ripple.Name = "_Ripple"
            ripple.BackgroundColor3 = Color3.fromRGB(255,255,255)
            ripple.BackgroundTransparency = 0.82
            ripple.BorderSizePixel = 0
            ripple.AnchorPoint = Vector2.new(0.5, 0.5)
            ripple.Position = UDim2.new(0, relX, 0, relY)
            ripple.Size = UDim2.new(0, 0, 0, 0)
            ripple.ZIndex = 1
            ripple.Active = false
            local rc = Instance.new("UICorner"); rc.CornerRadius = UDim.new(1,0); rc.Parent = ripple
            ripple.Parent = b
            local maxDim = math.max(b.AbsoluteSize.X, b.AbsoluteSize.Y) * 2.2
            TweenService:Create(ripple, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, maxDim, 0, maxDim),
                BackgroundTransparency = 1,
            }):Play()
            task.delay(0.6, function() if ripple.Parent then ripple:Destroy() end end)
        end
    end)
    b.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
