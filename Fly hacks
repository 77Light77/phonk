    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 22, 0, 22)
    knob.Position = UDim2.new(0, -11, 0.5, -11)
    knob.BackgroundTransparency = 1
    knob.ZIndex = 3
    knob.Parent = track

    local knobDot = Instance.new("Frame")
    knobDot.Size = UDim2.new(0, 14, 0, 14)
    knobDot.Position = UDim2.new(0.5, -7, 0.5, -7)
    knobDot.BackgroundColor3 = Theme.text
    knobDot.BorderSizePixel = 0
    knobDot.ZIndex = 3
    knobDot.Parent = knob
    local kdc = Instance.new("UICorner"); kdc.CornerRadius = UDim.new(1,0); kdc.Parent = knobDot
    tagBg(knobDot, "text")

    local skullLbl = Instance.new("TextLabel")
    skullLbl.Size = UDim2.new(1, 0, 1, 0)
    skullLbl.BackgroundTransparency = 1
    skullLbl.Text = "💀"
    skullLbl.TextSize = 18
    skullLbl.Font = Enum.Font.GothamBold
    skullLbl.TextColor3 = Color3.fromRGB(255,255,255)
    skullLbl.TextStrokeTransparency = 0.5
    skullLbl.TextStrokeColor3 = Color3.fromRGB(0,0,0)
    skullLbl.ZIndex = 4
    skullLbl.Visible = false
    skullLbl.Active = false
    skullLbl.Parent = knob

    local sl = { min=o.min, max=o.max, track=track, fill=fill, knob=knob, knobDot=knobDot, skullLbl=skullLbl }
    local function setVal(v, fire)
        v = math.clamp(v, o.min, o.max)
        local pct = (v - o.min) / (o.max - o.min)
        fill.Size = UDim2.new(pct,0,1,0)
        knob.Position = UDim2.new(pct, -11, 0.5, -11)
        local r = math.floor(v+0.5)
        if o.formatter then vl.Text = o.formatter(r) else vl.Text = tostring(r) end
        if fire and o.onChange then o.onChange(r) end
    end
    sl.updateFromMouse = function(mx)
        local pos = track.AbsolutePosition; local size = track.AbsoluteSize
        if size.X <= 0 then return end
        local pct = math.clamp((mx - pos.X)/size.X, 0, 1)
        setVal(o.min + (o.max - o.min)*pct, true)
    end
    sl.setValue = function(v) setVal(v, true) end
    sl.setValueSilent = function(v) setVal(v, false) end
    sl.setFillColor = function(c) fill.BackgroundColor3 = c end
    sl.applyThemeKnob = function()
        if Theme.mango then
            knobDot.Visible = false
            skullLbl.Visible = true
        else
            knobDot.Visible = true
            skullLbl.Visible = false
        end
    end
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
           or input.UserInputType == Enum.UserInputType.Touch then
            activeSlider = sl; sl.updateFromMouse(input.Position.X)
        end
    end)
    setVal(o.initial, false)
    if not ui.allSliders then ui.allSliders = {} end
    table.insert(ui.allSliders, sl)
    sl.applyThemeKnob()
    return sl
end
UserInputService.InputChanged:Connect(function(input)
