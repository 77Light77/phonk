-- ============ APPLY THEME ============
function applyTheme(name)
    local preset = THEME_PRESETS[name]; if not preset then return end
    for k,v in pairs(preset) do
        if k ~= "label" and k ~= "swatch" and k ~= "mango" then Theme[k] = v end
    end
    Theme.mango = preset.mango == true
    Settings.themeName = name
    applyThemeToDescendants()
    if ui.mangoBg then ui.mangoBg.Visible = Theme.mango end
    if ui.swatches then
        for n,sw in pairs(ui.swatches) do
            if n==ESP.colorName then sw.stroke.Color=Theme.accent; sw.stroke.Thickness=3
            else sw.stroke.Color=Color3.fromRGB(0,0,0); sw.stroke.Thickness=1 end
        end
    end
    if ui.themeSwatches then
        for n,sw in pairs(ui.themeSwatches) do
            if n==name then sw.stroke.Color=Theme.accent; sw.stroke.Thickness=3
            else sw.stroke.Color=Theme.border; sw.stroke.Thickness=1 end
        end
    end
    if ui.allSliders then
        for _, sl in ipairs(ui.allSliders) do
            sl.setFillColor(Theme.accent)
            sl.applyThemeKnob()
        end
    end
    updateUI()
    updateTabIndicators()
    if refreshSpectateUI then refreshSpectateUI() end
end

