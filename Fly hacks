            if not d.Parent or not d.Parent:GetAttribute("ToggledOn") then
                d.Color = Theme[sk]
            end
        end
    end
end

-- ============ STATS LOOP ============
local ServerStats = { frames=0, accumDt=0, smoothedFps=60, smoothedPing=0, lastUpdate=tick() }
local lastClockSecond = -1

RunService.RenderStepped:Connect(function(dt)
    ServerStats.frames = ServerStats.frames + 1
    ServerStats.accumDt = ServerStats.accumDt + dt
    local now = tick()
    if now - ServerStats.lastUpdate >= 0.5 then
        local avg = ServerStats.frames / math.max(ServerStats.accumDt, 0.0001)
        ServerStats.smoothedFps = ServerStats.smoothedFps*0.4 + avg*0.6
        local p = getPingMs()
        if p>0 then ServerStats.smoothedPing = ServerStats.smoothedPing*0.5 + p*0.5 end
        if ui.serverFpsValue then ui.serverFpsValue.Text = math.floor(ServerStats.smoothedFps+0.5).." FPS" end
        if ui.serverPingValue then ui.serverPingValue.Text = math.floor(ServerStats.smoothedPing+0.5).." ms" end
        if ui.serverRegionValue then ui.serverRegionValue.Text = estimateRegion(ServerStats.smoothedPing) end
        if ui.sessionTimeValue then ui.sessionTimeValue.Text = formatUptime(tick()-SESSION_START) end
        ServerStats.frames = 0; ServerStats.accumDt = 0; ServerStats.lastUpdate = now
    end
    if ui.clockLabel and ui.clockFrame and ui.clockFrame.Visible then
        local sec = os.time()
        if sec ~= lastClockSecond then
            lastClockSecond = sec
            ui.clockLabel.Text = format12h()
        end
    end
    if ui.posValue then
        local c = player.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if r then
            ui.posValue.Text = string.format("%d, %d, %d",
                math.floor(r.Position.X), math.floor(r.Position.Y), math.floor(r.Position.Z))
        end
    end
end)

-- ============ MOVEMENT ============
local function movementAllowed()
    if Settings.flying then return false end
    if Freecam.active then return false end
    if Spectate.active then return false end
    return true
end
function applyWalkSpeed()
    if not Settings.walkSpeedEnabled then return end
    if not movementAllowed() then return end
    local c = player.Character; if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid"); if not h then return end
    if math.abs(h.WalkSpeed - Settings.walkSpeed) > 0.01 then h.WalkSpeed = Settings.walkSpeed end
end
function applyJumpPower()
    if not Settings.jumpPowerEnabled then return end
    if not movementAllowed() then return end
    local c = player.Character; if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid"); if not h then return end
    pcall(function() if not h.UseJumpPower then h.UseJumpPower = true end end)
    if math.abs(h.JumpPower - Settings.jumpPower) > 0.01 then h.JumpPower = Settings.jumpPower end
end
function setWalkSpeedEnabled(on)
    Settings.walkSpeedEnabled = on
    if on then applyWalkSpeed()
    else
        local c = player.Character
        if c then
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then h.WalkSpeed = 16 end
        end
    end
    if updateUI then updateUI() end
    if updateTabIndicators then updateTabIndicators() end
end
function setJumpPowerEnabled(on)
    Settings.jumpPowerEnabled = on
    if on then applyJumpPower()
    else
        local c = player.Character
        if c then
            local h = c:FindFirstChildOfClass("Humanoid")
            if h then
                pcall(function() h.UseJumpPower = true end)
                h.JumpPower = 50
            end
        end
    end
    if updateUI then updateUI() end
    if updateTabIndicators then updateTabIndicators() end
end

-- ============ NOCLIP ============
local function noclipApplyToPart(part)
    if not part or not part:IsA("BasePart") then return end
    if NoclipState.savedCollide[part] == nil then NoclipState.savedCollide[part] = part.CanCollide end
    if NoclipState.savedQuery[part] == nil then NoclipState.savedQuery[part] = part.CanQuery end
    if NoclipState.savedTouch[part] == nil then NoclipState.savedTouch[part] = part.CanTouch end
    if part.CanCollide then pcall(function() part.CanCollide = false end) end
    if part.CanQuery then pcall(function() part.CanQuery = false end) end
    if part.CanTouch then pcall(function() part.CanTouch = false end) end
end
local function noclipApplyToCharacter(c)
    if not c then return end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("BasePart") then noclipApplyToPart(d) end
    end
end
local function noclipHookCharacter(c)
    if NoclipState.charConn then NoclipState.charConn:Disconnect(); NoclipState.charConn = nil end
    if not c then return end
    NoclipState.charConn = c.DescendantAdded:Connect(function(d)
        if not Settings.noclip then return end
        if d:IsA("BasePart") then noclipApplyToPart(d) end
    end)
end
local function noclipEnable()
    NoclipState.active = true
    NoclipState.savedCollide = {}; NoclipState.savedQuery = {}; NoclipState.savedTouch = {}
    local c = player.Character
    if c then
        noclipApplyToCharacter(c)
        noclipHookCharacter(c)
    end
    if not NoclipState.respawnConn then
        NoclipState.respawnConn = player.CharacterAdded:Connect(function(newChar)
            if not Settings.noclip then return end
            NoclipState.savedCollide = {}; NoclipState.savedQuery = {}; NoclipState.savedTouch = {}
            newChar:WaitForChild("Humanoid", 5); task.wait(0.1)
            noclipApplyToCharacter(newChar)
            noclipHookCharacter(newChar)
        end)
    end
end
local function noclipDisable()
    NoclipState.active = false
    for p, o in pairs(NoclipState.savedCollide) do if p and p.Parent then pcall(function() p.CanCollide = o end) end end
    for p, o in pairs(NoclipState.savedQuery) do if p and p.Parent then pcall(function() p.CanQuery = o end) end end
    for p, o in pairs(NoclipState.savedTouch) do if p and p.Parent then pcall(function() p.CanTouch = o end) end end
    NoclipState.savedCollide = {}; NoclipState.savedQuery = {}; NoclipState.savedTouch = {}
    if NoclipState.charConn then NoclipState.charConn:Disconnect(); NoclipState.charConn = nil end
end
function setNoclip(on)
    Settings.noclip = on
    if on then noclipEnable() else noclipDisable() end
    if updateUI then updateUI() end
    if updateTabIndicators then updateTabIndicators() end
end

