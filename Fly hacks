-- 5) Global hotkeys
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if rebindingAny then return end
    if isTyping() then return end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if input.KeyCode == Settings.uiKey then
            setGuiOpen(not Settings.guiOpen)
        elseif input.KeyCode == Settings.toggleKey then
            if Settings.flying then stopFly() else startFly() end
        elseif input.KeyCode == Freecam.keybind then
            if Freecam.active then stopFreecam() else startFreecam() end
        elseif input.KeyCode == Settings.walkSpeedKey then
            setWalkSpeedEnabled(not Settings.walkSpeedEnabled)
        elseif input.KeyCode == Settings.noclipKey then
            setNoclip(not Settings.noclip)
        elseif input.KeyCode == Settings.potatoKey then
            setPotato(not Settings.potato)
            notify(Settings.potato and "Potato graphics on" or "Potato graphics off",
                   Settings.potato and Theme.accent or Theme.danger)
        end
    end
    if Settings.clickTeleport and isClickTeleportInput(input) and not Settings.guiOpen then
        doTeleportFromMouse()
    end
end)

-- 6) Restore pending ESP selections on late-joining players
Players.PlayerAdded:Connect(function(plr)
    if Settings.pendingESPUserIds and Settings.pendingESPUserIds[tostring(plr.UserId)] then
        ESP.selected[plr] = true
        if ESP.enabled then
            task.wait(0.2)
            createESPForPlayer(plr)
        end
    end
end)

-- 7) Respawn cleanup
player.CharacterAdded:Connect(function(newChar)
    if Settings.flying then pcall(stopFly) end
    if Spectate.active then pcall(stopSpectate) end

    character = newChar
    humanoid = newChar:WaitForChild("Humanoid")
    rootPart = newChar:WaitForChild("HumanoidRootPart")
    task.wait(0.3)
    if Settings.walkSpeedEnabled then applyWalkSpeed() end
    if Settings.jumpPowerEnabled then applyJumpPower() end
    if Settings.noclip then
        noclipApplyToCharacter(newChar)
        noclipHookCharacter(newChar)
    end
end)

