local function buildSaveData()
    local data = {
        version = 1,
        flySpeed = Settings.flySpeed,
        toggleKey = enumToTable(Settings.toggleKey),
        uiKey = enumToTable(Settings.uiKey),
        uiScale = Settings.uiScale,
        notifications = Settings.notifications,
        spectateZoom = Settings.spectateZoom,
        tracers = Settings.tracers,
        clockEnabled = Settings.clockEnabled,
        walkSpeed = Settings.walkSpeed,
        walkSpeedEnabled = Settings.walkSpeedEnabled,
        walkSpeedKey = enumToTable(Settings.walkSpeedKey),
        jumpPower = Settings.jumpPower,
        jumpPowerEnabled = Settings.jumpPowerEnabled,
        infiniteJump = Settings.infiniteJump,
        noclipKey = enumToTable(Settings.noclipKey),
        potatoKey = enumToTable(Settings.potatoKey),
        infiniteZoom = Settings.infiniteZoom,
        espScale = Settings.espScale,
        espNames = Settings.espNames,
        espColorName = ESP.colorName,
        clickTeleport = Settings.clickTeleport,
        clickTeleportInput = enumToTable(Settings.clickTeleportInput),
        themeName = Settings.themeName,
        fullbright = Settings.fullbright,
        freecamSpeed = Freecam.speed,
        freecamKeybind = enumToTable(Freecam.keybind),
        espSelectedUserIds = {},
    }
    for plr, sel in pairs(ESP.selected) do
        if sel and typeof(plr) == "Instance" and plr.UserId and plr.UserId > 0 then
            table.insert(data.espSelectedUserIds, tostring(plr.UserId))
        end
    end
    return data
end

local function applySaveData(data)
    if type(data) ~= "table" then return false end
    local function num(v, def, mn, mx)
        if type(v) ~= "number" then return def end
        if mn and v < mn then return mn end
        if mx and v > mx then return mx end
        return v
    end
    if type(data.flySpeed) == "number" then Settings.flySpeed = num(data.flySpeed, Settings.flySpeed, Settings.minSpeed, Settings.maxSpeed) end
    local tk = tableToEnum(data.toggleKey); if tk then Settings.toggleKey = tk end
    local uk = tableToEnum(data.uiKey); if uk then Settings.uiKey = uk end
    if type(data.uiScale) == "number" then Settings.uiScale = num(data.uiScale, 1, 0.5, 3) end
    if type(data.notifications) == "boolean" then Settings.notifications = data.notifications end
    if type(data.spectateZoom) == "number" then Settings.spectateZoom = num(data.spectateZoom, 22, 1, 200) end
    if type(data.tracers) == "boolean" then Settings.tracers = data.tracers end
    if type(data.clockEnabled) == "boolean" then Settings.clockEnabled = data.clockEnabled end
    if type(data.walkSpeed) == "number" then Settings.walkSpeed = num(data.walkSpeed, 16, 0, 1000) end
    if type(data.walkSpeedEnabled) == "boolean" then Settings.walkSpeedEnabled = data.walkSpeedEnabled end
    local wsk = tableToEnum(data.walkSpeedKey); if wsk then Settings.walkSpeedKey = wsk end
    if type(data.jumpPower) == "number" then Settings.jumpPower = num(data.jumpPower, 50, 0, 1000) end
    if type(data.jumpPowerEnabled) == "boolean" then Settings.jumpPowerEnabled = data.jumpPowerEnabled end
    if type(data.infiniteJump) == "boolean" then Settings.infiniteJump = data.infiniteJump end
    local nck = tableToEnum(data.noclipKey); if nck then Settings.noclipKey = nck end
    local ptk = tableToEnum(data.potatoKey); if ptk then Settings.potatoKey = ptk end
    if type(data.infiniteZoom) == "boolean" then Settings.infiniteZoom = data.infiniteZoom end
    if type(data.espScale) == "number" then Settings.espScale = num(data.espScale, 1, 0.3, 3) end
    if type(data.espNames) == "boolean" then Settings.espNames = data.espNames end
    if type(data.espColorName) == "string" and COLOR_PRESETS[data.espColorName] then
        ESP.colorName = data.espColorName
        local p = COLOR_PRESETS[data.espColorName]
        ESPColor.fill = p.fill; ESPColor.outline = p.outline; ESPColor.dist = p.dist
    end
    if type(data.clickTeleport) == "boolean" then Settings.clickTeleport = data.clickTeleport end
    local cti = tableToEnum(data.clickTeleportInput)
    if cti then Settings.clickTeleportInput = cti end
    if type(data.themeName) == "string" and THEME_PRESETS[data.themeName] then
        Settings.themeName = data.themeName
    end
    if type(data.fullbright) == "boolean" then Settings.fullbright = data.fullbright end
    if type(data.freecamSpeed) == "number" then Freecam.speed = num(data.freecamSpeed, 70, Freecam.minSpeed, Freecam.maxSpeed) end
    local fck = tableToEnum(data.freecamKeybind); if fck then Freecam.keybind = fck end
    Settings.pendingESPUserIds = {}
    if type(data.espSelectedUserIds) == "table" then
        for _, uid in ipairs(data.espSelectedUserIds) do
            if type(uid) == "string" then
                Settings.pendingESPUserIds[uid] = true
            end
        end
    end
    return true
end

local function doSave()
    if not hasFileIO() then
        Save.status = "File API not available"
        notify("File API not available", Theme.warn)
        return false
    end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(buildSaveData()) end)
    if not ok or not encoded then
        Save.status = "Encode failed"
        notify("Save encode failed", Theme.danger)
        return false
    end
    local ok2 = pcall(function() writefile(SAVE_FILE, encoded) end)
    if not ok2 then
        Save.status = "Write failed"
        notify("Save write failed", Theme.danger)
        return false
    end
    Save.lastSaveTick = tick()
    Save.status = "Saved " .. os.date("%H:%M:%S")
    notify("Settings saved", Theme.accent)
    return true
end

local function doLoad(silent)
    if not hasFileIO() then
        Save.status = "File API unavailable"
        return false
    end
    local ok, exists = pcall(function() return isfile(SAVE_FILE) end)
    if not ok or not exists then
        Save.status = "No save file"
        if not silent then notify("No save file found", Theme.warn) end
        return false
    end
    local ok2, raw = pcall(function() return readfile(SAVE_FILE) end)
    if not ok2 or not raw then
        Save.status = "Read failed"
        return false
    end
    local ok3, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok3 or type(data) ~= "table" then
        Save.status = "Corrupt save file"
        return false
    end
    local ok4 = applySaveData(data)
    if not ok4 then Save.status = "Invalid save data"; return false end
    Save.status = "Loaded " .. os.date("%H:%M:%S")
    if not silent then notify("Settings loaded", Theme.accent) end
    return true
end

local function applyPendingESPSelections()
    if not Settings.pendingESPUserIds then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local uid = tostring(plr.UserId)
            if Settings.pendingESPUserIds[uid] then
                ESP.selected[plr] = true
            end
        end
    end
end

