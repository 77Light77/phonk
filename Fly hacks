    bodyGyro.Parent = rootPart
    if humanoid then
        FlySaved.humanoid = humanoid
        FlySaved.walkSpeed = humanoid.WalkSpeed
        FlySaved.jumpPower = humanoid.JumpPower
        humanoid.WalkSpeed = 0; humanoid.JumpPower = 0; humanoid.AutoRotate = false
    end
    Settings.flying = true
    notify("Fly enabled", Theme.accent); updateUI(); updateTabIndicators()
end
local function stopFly()
    if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity=nil end
    if bodyGyro then bodyGyro:Destroy(); bodyGyro=nil end
    Settings.flying = false
