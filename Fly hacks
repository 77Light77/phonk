    if Freecam.controls then return Freecam.controls end
    local ok, m = pcall(function() return require(player.PlayerScripts:WaitForChild("PlayerModule",5)) end)
    if not ok or not m then return nil end
    local ok2, c = pcall(function() return m:GetControls() end)
    if not ok2 or not c then return nil end
